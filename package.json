{
  "name": "claude-desktop-open-source-reconstruction",
  "productName": "Claude Local",
  "version": "1.21459.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "Clean-room, evidence-backed reconstruction of the Claude Desktop shell",
  "scripts": {
    "reference:extract": "node tools/extract-reference.mjs",
    "reference:analyze": "node tools/analyze-reference.mjs",
    "reference:preloads": "node tools/extract-preload-api.mjs",
    "reference:signatures": "node tools/extract-ipc-signatures.mjs",
    "reference:generate": "node tools/generate-contracts.mjs",
    "reference:coverage": "node tools/report-implementation.mjs",
    "reference:recover": "npm run reference:extract && npm run reference:analyze && npm run reference:preloads && npm run reference:signatures && npm run reference:generate && npm run reference:coverage",
    "build": "npm run typecheck && node tools/build-electron.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "verify": "npm run format:check && npm test && npm run build",
    "smoke:hosted": "node tools/smoke-electron.mjs hosted",
    "smoke:local": "node tools/smoke-electron.mjs local",
    "smoke:local-chat": "node tools/smoke-local-chat.mjs",
    "smoke:local-reasoning": "node tools/smoke-local-chat.mjs reasoning",
    "smoke:local-diagram": "node tools/smoke-local-chat.mjs diagram",
    "smoke:local-artifact": "node tools/smoke-local-chat.mjs artifact",
    "smoke:local-attachment": "node tools/smoke-local-chat.mjs attachment",
    "smoke:local-code": "node tools/smoke-local-code.mjs",
    "smoke:local-code-permission": "node tools/smoke-local-code.mjs permission",
    "smoke:local-code-bypass": "node tools/smoke-local-code.mjs bypass",
    "smoke:local-code-terminal": "node tools/smoke-local-code.mjs terminal",
    "smoke:standalone": "node tools/smoke-standalone.mjs",
    "probe:real-settings": "node tools/probe-real-settings.mjs",
    "probe:real-navigation": "node tools/probe-real-navigation.mjs",
    "probe:real-file-preview": "node tools/probe-real-file-preview.mjs",
    "probe:real-launch-preview": "node tools/probe-real-launch-preview.mjs",
    "probe:real-artifact-gallery": "node tools/probe-real-artifact-gallery.mjs",
    "smoke:real-chat": "node tools/probe-real-chat.mjs",
    "smoke:real-attachment": "node tools/probe-real-chat.mjs attachment",
    "smoke:real-artifact": "node tools/probe-real-chat.mjs artifact",
    "smoke:real-code": "node tools/smoke-local-code.mjs real",
    "smoke:real-code-permission": "node tools/smoke-local-code.mjs real permission",
    "smoke:real-code-bypass": "node tools/smoke-local-code.mjs real bypass",
    "smoke:real-code-terminal": "node tools/smoke-local-code.mjs real terminal",
    "smoke:real-code-all-tools": "node tools/smoke-local-code.mjs real all-tools",
    "smoke:real": "node tools/smoke-real.mjs",
    "dev": "vite",
    "start": "electron ."
  },
  "dependencies": {
    "mermaid": "11.16.0",
    "node-pty": "1.2.0-beta.13",
    "playwright-core": "^1.55.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@electron/asar": "^3.4.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "42.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
