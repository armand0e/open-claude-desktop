{
  "name": "open-claude",
  "productName": "Open-Claude",
  "desktopName": "Open-Claude.desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "A standalone, local-first reconstruction of the Claude Desktop experience",
  "author": "Open-Claude contributors",
  "scripts": {
    "reference:extract": "node tools/extract-reference.mjs",
    "reference:analyze": "node tools/analyze-reference.mjs",
    "reference:preloads": "node tools/extract-preload-api.mjs",
    "reference:signatures": "node tools/extract-ipc-signatures.mjs",
    "reference:generate": "node tools/generate-contracts.mjs",
    "reference:coverage": "node tools/report-implementation.mjs",
    "reference:recover": "npm run reference:extract && npm run reference:analyze && npm run reference:preloads && npm run reference:signatures && npm run reference:generate && npm run reference:coverage",
    "build": "npm run typecheck && node tools/build-electron.mjs && vite build",
    "dist:win": "npm run build && node tools/prepare-package-assets.mjs && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && node tools/prepare-package-assets.mjs && electron-builder --linux AppImage --x64",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "verify": "npm run format:check && npm test && npm run build",
    "smoke:hosted": "node tools/smoke-electron.mjs hosted",
    "smoke:local": "node tools/smoke-electron.mjs local",
    "smoke:local-chat": "node tools/smoke-local-chat.mjs",
    "probe:streaming-flow": "node tools/smoke-local-chat.mjs flow",
    "smoke:local-reasoning": "node tools/smoke-local-chat.mjs reasoning",
    "smoke:local-diagram": "node tools/smoke-local-chat.mjs diagram",
    "smoke:local-artifact": "node tools/smoke-local-chat.mjs artifact",
    "probe:web-search-toggle": "node tools/smoke-local-chat.mjs web-disabled",
    "probe:retry-state": "node tools/smoke-local-chat.mjs retry",
    "smoke:local-attachment": "node tools/smoke-local-chat.mjs attachment",
    "smoke:local-code": "node tools/smoke-local-code.mjs",
    "probe:code-streaming": "node tools/smoke-local-code.mjs streaming",
    "smoke:local-code-permission": "node tools/smoke-local-code.mjs permission",
    "smoke:local-code-bypass": "node tools/smoke-local-code.mjs bypass",
    "smoke:local-code-terminal": "node tools/smoke-local-code.mjs terminal",
    "smoke:standalone": "node tools/smoke-standalone.mjs",
    "smoke:packaged": "node tools/smoke-packaged.mjs",
    "probe:save-memory": "node tools/probe-save-memory.mjs",
    "probe:sandbox-chat": "node tools/probe-sandbox-chat.mjs",
    "probe:dictation-stream": "node tools/probe-dictation-stream.mjs",
    "probe:project-page": "node tools/probe-project-page.mjs",
    "probe:publish-artifact": "node tools/probe-publish-artifact.mjs",
    "probe:code-sidebar": "node tools/probe-code-sidebar.mjs",
    "probe:real-settings": "node tools/probe-real-settings.mjs",
    "probe:real-chat-navigation": "node tools/probe-real-chat-navigation.mjs",
    "probe:real-navigation": "node tools/probe-real-navigation.mjs",
    "probe:real-file-preview": "node tools/probe-real-file-preview.mjs",
    "probe:real-launch-preview": "node tools/probe-real-launch-preview.mjs",
    "probe:real-code-artifact-selection": "node tools/probe-real-code-artifact-selection.mjs",
    "probe:real-artifact-gallery": "node tools/probe-real-artifact-gallery.mjs",
    "smoke:real-chat": "node tools/probe-real-chat.mjs",
    "smoke:real-web": "node tools/probe-real-chat.mjs web",
    "smoke:real-attachment": "node tools/probe-real-chat.mjs attachment",
    "smoke:real-artifact": "node tools/probe-real-chat.mjs artifact",
    "smoke:real-code": "node tools/smoke-local-code.mjs real",
    "smoke:real-code-permission": "node tools/smoke-local-code.mjs real permission",
    "smoke:real-code-bypass": "node tools/smoke-local-code.mjs real bypass",
    "smoke:real-code-terminal": "node tools/smoke-local-code.mjs real terminal",
    "smoke:real-code-all-tools": "node tools/smoke-local-code.mjs real all-tools",
    "smoke:real": "node tools/smoke-real.mjs",
    "mock:openai": "node tools/mock-openai-server.mjs",
    "dev": "vite",
    "start": "electron ."
  },
  "build": {
    "appId": "io.openclaude.desktop",
    "productName": "Open-Claude",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": ".package-assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/main/local-search-proxy.cjs",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".package-assets/ion-dist",
        "to": "ion-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/builtin-skills",
        "to": "builtin-skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/whisper/ggml-base-q5_1.bin",
        "to": "whisper/ggml-base-q5_1.bin"
      }
    ],
    "protocols": [
      {
        "name": "Open-Claude",
        "schemes": [
          "open-claude"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Open-Claude",
      "icon": ".package-assets/icon.png",
      "extraResources": [
        {
          "from": "assets/whisper/win",
          "to": "whisper/bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "open-claude",
      "icon": ".package-assets/icon.png",
      "category": "Development",
      "artifactName": "Open-Claude-${version}-x86_64.${ext}",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "assets/whisper/linux",
          "to": "whisper/bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Open-Claude-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open-Claude",
      "uninstallDisplayName": "Open-Claude",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    }
  },
  "dependencies": {
    "localtunnel": "^2.0.2",
    "mermaid": "11.16.0",
    "node-pty": "1.2.0-beta.13",
    "pdfjs-dist": "^6.1.200",
    "playwright-core": "^1.55.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@electron/asar": "^3.4.1",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "42.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
